+// Rosa x/15 — przywrócona istniejąca logika calculateLeafWetness() z Aura Pogoda v1.0
+// (repo Pogoda-API, src/utils/weatherUtils.ts, skala 0–15 zwilżenia/rosy). Progi i przedziały punktów bez zmian.
+// Wartość wynika przede wszystkim z różnicy T − punkt rosy; pomocniczo: wilgotność, wiatr, zachmurzenie, dzień/noc, opad.
+// Jedyna zmiana względem oryginału: zachmurzenie osłabia nocne/dzienne wychładzanie radiacyjne (wcześniej nieużywane).
+// Punkt rosy pochodzi z istniejącej dewPoint() albo ze stacji IMGW — nie ma tu drugiego algorytmu.
+function dewWetness(o){
+  const temp=o.temp,dew=o.dew;
+  if(!Number.isFinite(temp)||!Number.isFinite(dew))return null;
+  const h=Number.isFinite(o.hum)?clamp(o.hum,0,100):50;
+  const w=Number.isFinite(o.wind)?Math.max(0,o.wind):10;
+  const night=o.isDay===false||o.isDay===0;
+  const code=Number.isFinite(o.code)?o.code:null;
+  const p=Number.isFinite(o.precip)?Math.max(0,o.precip):0;
+  const isPrecipCode=code!=null&&code>=50&&code<=99;
+  const isRecentPrecipCode=code!=null&&code>=20&&code<=29;
+  const isFogCode=code===45||code===48;
+  // 1. Opad ma pierwszeństwo (jak w oryginale)
+  if(p>0.05)return{score:Math.min(15,Math.max(12,Math.round(12+Math.min(3,p*2)))),label:"Zwilżenie deszczowe"};
+  if(p>0)return{score:11,label:"Śladowy opad"};
+  if(isPrecipCode)return{score:10,label:"Mokry liść, mżawka"};
+  // 2. Kondensacja: efektywna różnica T − Td (po odjęciu wychładzania radiacyjnego liścia)
+  const rawDepression=Math.max(0,temp-dew);
+  const calmFactor=Math.max(0.15,1-Math.min(1,w/28));                  // wiatr miesza powietrze i osusza liście
+  const clearFactor=Number.isFinite(o.cloud)?1-0.75*clamp(o.cloud,0,100)/100:1; // chmury ograniczają wychładzanie
+  const radiativeDrop=(night?2.3:0.4)*calmFactor*clearFactor;
+  const eff=Math.max(0,rawDepression-radiativeDrop);
+  let sc=0;
+  if(eff<=0.5||h>=95||(isFogCode&&h>=88)){
+    sc=Math.min(11,Math.max(8,eff<=0.2?11:eff<=0.4?10:9));
+  }else if(eff<=1.8||h>=84||(isFogCode&&h>=75)){
+    sc=Math.min(7,Math.max(4,Math.round(7-((eff-0.5)/1.3)*3)));
+  }else if(eff<=3.8||(night&&h>=68)||(!night&&h>=74)){
+    sc=Math.min(3,Math.max(2,eff<=2.8||h>=75?3:2));
+  }else if(eff<=5.0&&night&&w<=12){
+    sc=1;
+  }
+  if(isRecentPrecipCode&&sc<6&&h>=70)sc=Math.min(8,sc+3);
+  if(w>20&&sc>0&&sc<=7)sc=Math.max(0,sc-1);
+  sc=Math.min(15,Math.max(0,sc));
+  const label=sc>=12?"Mokry liść":sc>=8?(night?"Obfita rosa nocna":"Obfita rosa poranna"):sc>=4?"Lekka rosa":sc>=2?(night?"Możliwa rosa nocna":"Śladowa wilgoć"):sc===1?"Prawie sucho":"Sucho";
+  return{score:sc,label};
+}
